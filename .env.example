# Supabase project settings (Project Settings > API)
# Used by the browser bundle. These values are safe to expose publicly.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Supabase server settings (Project Settings > API)
# Required for server routes/functions. Keep the service-role key secret.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional Supabase CLI/project reference helper. Not read by the app runtime.
SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Application origin used to build absolute invitation links.
# Example: https://yourdomain.co.zw
APP_ORIGIN=https://yourdomain.co.zw
# PUBLIC_APP_ORIGIN is accepted as a fallback by the server code.
PUBLIC_APP_ORIGIN=https://yourdomain.co.zw

# Resend email settings used for organization invitation emails.
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL="My Platform <noreply@yourdomain.co.zw>"
